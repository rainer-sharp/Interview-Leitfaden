APP_PORT=8080
SECRET_KEY=bitte-aendern
ADMIN_PASSWORD=bitte-aendern
DATABASE_URL=sqlite:////app/data/interviews.db
BACKUP_KEEP_DAYS=14
DOMAIN=interviews.example.de

# Transkription von Audio-Aufnahmen (optional). Leer = Vorgabe aus transcribe_interview.py.
# URL, Modell und Schlüssel lassen sich auch in der App unter „Einstellungen“ ändern; die gelten dann vorrangig.
TRANSCRIBE_URL=http://192.168.101.95:8001/v1
TRANSCRIBE_MODEL=
TRANSCRIBE_API_KEY=
# Größte erlaubte Aufnahme in MB; Dateien liegen unter data/audio/
MAX_AUDIO_MB=4096

# KI-Bewertung von Interviews über ein LLM (OpenAI-kompatibel, z. B. vLLM). Leer = Vorgabe
# (http://192.168.101.94:8000/v1, Modell automatisch: das erste unter /models). In der App unter „Einstellungen“ änderbar.
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
